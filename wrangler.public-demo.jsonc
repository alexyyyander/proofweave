{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proofweave-public-demo",
  "account_id": "cb0a0233b0f4e2f803ed6e43fb57a894",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "vars": {
    "PROOFWEAVE_DEMO_AUTH_ENABLED": "true",
    "PROOFWEAVE_DEMO_PERSON_LABEL": "Build Week Demo Person"
  },
  "secrets": {
    "required": ["TURSO_DATABASE_URL", "TURSO_AUTH_TOKEN"]
  },
  "observability": {
    "enabled": true
  }
}
