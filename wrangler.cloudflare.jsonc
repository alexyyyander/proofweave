{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proofweave",
  "account_id": "536799122b9ceaba8d5dc6d0570bbfc8",
  "main": "worker/cloudflare.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "ANCHOR_MANIFEST_BUCKET",
      "bucket_name": "proofweave-anchor-manifests"
    }
  ],
  "vars": {
    "PROOFWEAVE_HOSTING_PLATFORM": "cloudflare",
    "PROOFWEAVE_DEPLOYMENT_STAGE": "validation",
    "PROOFWEAVE_CONTROL_PLANE_MODE": "read_only",
    "PROOFWEAVE_PARTICIPANT_CONTROL_PLANE_MODE": "read_only",
    "PROOFWEAVE_MCP_CONTROL_PLANE_MODE": "read_only",
    "PROOFWEAVE_DEMO_AUTH_ENABLED": "false",
    "OAUTH_ISSUER_URL": "https://proofweave.proofweave-alexyu.workers.dev",
    "MCP_RESOURCE_URL": "https://proofweave.proofweave-alexyu.workers.dev/api/mcp",
    "GOOGLE_OAUTH_REDIRECT_URI": "https://proofweave.proofweave-alexyu.workers.dev/auth/google/callback",
    "ANCHOR_BATCH_MAX_INTERVAL_SECONDS": "86400",
    "ANCHOR_BATCH_MIN_LEAVES": "96",
    "ANCHOR_CONFIRMATION_THRESHOLD": "12",
    "OAUTH_LEGACY_ISSUER_URL": "https://proofweave-research.yualex031821.chatgpt.site",
    "RUNNER_APPROVED_IMAGES_JSON": "[{\"imageDigest\":\"ghcr.io/alexyyyander/proofweave-lean-runner@sha256:ca896ab3945034079ab7f7cedfc7c5e665a601299c1745b51a72736420957393\",\"leanToolchain\":\"leanprover/lean4:v4.31.0\",\"mathlibRevision\":\"9a9483a92959bc92bd6a60176dd1fe597298c1f8\"}]",
    "RUNNER_CONTROL_PLANE_KEY_ID": "control-plane:cloudflare-2026-10-16",
    "RUNNER_DEFAULT_LIMITS_JSON": "{\"cpuSeconds\":300,\"wallSeconds\":1200,\"memoryMiB\":8192,\"diskMiB\":2048,\"outputBytes\":1000000}",
    "RUNNER_QUEUE_MODE": "d1",
    "RUNNER_WAKE_URL": "https://proofweave-trusted-runner.onrender.com/v1/wake",
    "RECEIPT_ISSUER_KEY_ID": "receipt-issuer:cloudflare-2026-10-16",
    "RECEIPT_ISSUER_PUBLIC_KEY": "wCKr1gD89vc5MbOqsbTYpvACAcxG6ATHEa0vdOKHeyA",
    "RECEIPT_ISSUER_ACTIVATED_AT": "2026-10-16T09:53:14.135Z",
    "PROOFWEAVE_ACCOUNT_AUTH_MODE": "read_only",
    "PROOFWEAVE_CONNECTION_CONTROL_PLANE_MODE": "read_only"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITES_BRIDGE_TRANSACTIONS",
        "class_name": "SitesBridgeTransaction"
      }
    ]
  },
  "migrations": [
    {
      "tag": "sites-login-bridge-v1",
      "new_sqlite_classes": [
        "SitesBridgeTransaction"
      ]
    }
  ]
}
