      "slug": "formal-conjectures-erdos-20",
      "kind": "frontier",
      "title": "Erdős–Rado Sunflower Conjecture",
      "summary": "The sunflower problem asks how large a uniform set family must be before a sunflower is unavoidable; the catalog pairs the open exponential question with the classical factorial bound.",
      "visibility": "public",
      "records": [
        {
          "id": "problem-revision:formal-conjectures:erdos-20:main:1",
          "targetKey": "erdos-20-main",
          "slug": "sunflower-conjecture",
          "title": "Erdős–Rado Sunflower Conjecture",
          "domain": "Combinatorics",
          "subjects": [{ "slug": "combinatorics", "isPrimary": true }],
          "collection": { "slug": "founding-challenges", "role": "headline", "position": 20 },
          "researchStatus": "research_open",
          "informalStatement": "For each number of petals k, the largest n-uniform family with no k-sunflower is bounded exponentially in n.",
          "leanStatement": "theorem erdos_20 : answer(sorry) ↔ ∃ (c : ℕ → ℕ), ∀ n k, n > 0 → f n k < (c k) ^ n := by\n  sorry",
          "proofState": "admitted",
          "sourceCorrespondence": "imported_unreviewed",
          "priority": 98,
          "declaration": { "id": "declaration:formal-conjectures:erdos-20", "qualifiedName": "Erdos20.erdos_20", "kind": "theorem", "sourcePath": "FormalConjectures/ErdosProblems/20.lean", "sourceLineStart": 51, "sourceLineEnd": 51, "sourceContentHash": "sha256:a30fae786a2dab55d5a42b4cb74dd12b4e4e858d3513748c71ef14ff48b0ef4a" }
        },
        {
          "id": "problem-revision:formal-conjectures:erdos-20:erdos-rado-bound:1",
          "targetKey": "erdos-20-erdos-rado-bound",
          "slug": "sunflower-erdos-rado-bound",
          "title": "Sunflower: Erdős–Rado bound",
          "domain": "Combinatorics",
          "subjects": [{ "slug": "combinatorics", "isPrimary": true }],
          "collection": { "slug": "founding-challenges", "role": "milestone", "position": 21 },
          "researchStatus": "research_solved",
          "informalStatement": "The classical Erdős–Rado argument bounds the sunflower-free extremal function by (k − 1)ⁿ n! + 1.",
          "leanStatement": "theorem erdos_20.variants.erdos_rado_bound :\n    ∀ n k, n > 0 → 2 ≤ k → f n k ≤ (k - 1) ^ n * n.factorial + 1 := by\n  sorry",
          "proofState": "admitted",
          "sourceCorrespondence": "imported_unreviewed",
          "priority": 88,
          "declaration": { "id": "declaration:formal-conjectures:erdos-20-erdos-rado-bound", "qualifiedName": "Erdos20.erdos_20.variants.erdos_rado_bound", "kind": "theorem", "sourcePath": "FormalConjectures/ErdosProblems/20.lean", "sourceLineStart": 62, "sourceLineEnd": 63, "sourceContentHash": "sha256:a30fae786a2dab55d5a42b4cb74dd12b4e4e858d3513748c71ef14ff48b0ef4a" }
