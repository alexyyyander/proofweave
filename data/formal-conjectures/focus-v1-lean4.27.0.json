      "id": "project:formal-conjectures:lonely-runner",
      "slug": "formal-conjectures-lonely-runner",
      "kind": "frontier",
      "title": "Lonely Runner Conjecture",
      "summary": "A Diophantine approximation problem about runners with distinct speeds, paired with a proved quantitative spacing milestone.",
      "visibility": "public",
      "records": [
        {
          "id": "problem-revision:formal-conjectures:lonely-runner:main:1",
          "targetKey": "lonely-runner-main",
          "slug": "lonely-runner",
          "title": "Lonely Runner Conjecture",
          "domain": "Number theory",
          "subjects": [{ "slug": "number-theory", "isPrimary": true }],
          "collection": { "slug": "founding-challenges", "role": "headline", "position": 40 },
          "researchStatus": "research_open",
          "informalStatement": "For runners with distinct constant speeds on a unit circle, each runner is eventually at least 1/n from every other runner.",
          "leanStatement": "theorem lonely_runner_conjecture (n : ℕ)\n    (speed : Fin n ↪ ℝ) (lonely : Fin n → ℝ → Prop)\n    (lonely_def :\n      ∀ r t, lonely r t ↔\n        ∀ r2 : Fin n, r2 ≠ r →\n        dist (t * speed r : UnitAddCircle) (t * speed r2) ≥ 1 / n)\n    (r : Fin n) : ∃ t ≥ 0, lonely r t := by\n  sorry",
          "proofState": "admitted",
          "sourceCorrespondence": "imported_unreviewed",
          "priority": 96,
          "declaration": { "id": "declaration:formal-conjectures:lonely-runner", "qualifiedName": "LonelyRunnerConjecture.lonely_runner_conjecture", "kind": "theorem", "sourcePath": "FormalConjectures/Wikipedia/LonelyRunnerConjecture.lean", "sourceLineStart": 36, "sourceLineEnd": 42, "sourceContentHash": "sha256:a9f9d2504bb1f29e52e659a26080edf68b76a95abe4af8e68b1d6d404be1a309" }
        },
        {
          "id": "problem-revision:formal-conjectures:lonely-runner:tao-2017:1",
          "targetKey": "lonely-runner-tao-2017",
          "slug": "lonely-runner-tao-2017",
          "title": "Lonely Runner: Tao 2017 spacing bound",
          "domain": "Number theory",
          "subjects": [{ "slug": "number-theory", "isPrimary": true }],
          "collection": { "slug": "founding-challenges", "role": "milestone", "position": 41 },
          "researchStatus": "research_solved",
          "informalStatement": "A quantitative lower bound improves the universal gap beyond 1/(2n) for all sufficiently large n.",
          "leanStatement": "theorem lonely_runner_conjecture.variants.tao_2017 :\n    ∃ c : ℝ, 0 < c ∧\n      (∀ᶠ n : ℕ in Filter.atTop,\n        deltaGap n ≥\n          ((1 : ℝ) / (2 * (n : ℝ))\n            + c * Real.log (n : ℝ) /\n                ((n : ℝ) ^ 2 * (Real.log (Real.log (n : ℝ))) ^ 2))) := by\n  sorry",
          "proofState": "admitted",
          "sourceCorrespondence": "imported_unreviewed",
          "priority": 86,
          "declaration": { "id": "declaration:formal-conjectures:lonely-runner-tao-2017", "qualifiedName": "LonelyRunnerConjecture.lonely_runner_conjecture.variants.tao_2017", "kind": "theorem", "sourcePath": "FormalConjectures/Wikipedia/LonelyRunnerConjecture.lean", "sourceLineStart": 70, "sourceLineEnd": 76, "sourceContentHash": "sha256:a9f9d2504bb1f29e52e659a26080edf68b76a95abe4af8e68b1d6d404be1a309" }
