# Public URL used when generating links outside a request context.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional Google OpenID Connect sign-in. Configure these as hosted environment
# variables/secrets; never commit real values. The authorized redirect URI must
# exactly match the public HTTPS callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-proofweave-host.example/auth/google/callback

# Canonical public origin for the separately deployed Lean Runner. The web
# Worker must never execute user Lean code directly. `/healthz` is a derived
# probe path, not another authority.
PROOFWEAVE_RUNNER_URL=https://proofweave-trusted-runner.onrender.com
PROOFWEAVE_RUNNER_AUDIENCE=proofweave-lean-runner

# Active alpha control plane for the Sites-integrated browser, identity, and
# `/api/mcp` gateway routes, and for the Render trusted Runner. Both values must
# be configured together on every active surface. The logical Sites D1 binding
# remains a local/fallback resource but is not the release authority. For a new
# Turso database, run `npm run turso:bootstrap`; it writes local values only to
# the gitignored `.env.local` file with mode 0600. Never commit the real token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Privacy-safe release identity projected by Site `/api/mcp/capabilities` and
# Runner `/healthz`. Set these from the exact saved deployment result, never
# from a client request. Sites reads the project ID from `.openai/hosting.json`;
# the separately deployed Runner must receive the same reviewed ID explicitly.
PROOFWEAVE_RELEASE_SITES_COMMIT_SHA=
PROOFWEAVE_RELEASE_SITES_VERSION=
PROOFWEAVE_RELEASE_SITE_PROJECT_ID=appgprj_6a54400d01a8819199224b722afae056

# MCP control-plane Receipt issuer. The three public values may be normal
# hosted environment variables; the private JWK must be stored as a hosted
# secret and must never be committed. Omitting all four keeps signed reviews
# durable but reports receipt closure as issuer_unavailable.
RECEIPT_ISSUER_KEY_ID=
RECEIPT_ISSUER_PUBLIC_KEY=
RECEIPT_ISSUER_PRIVATE_KEY_JWK=
RECEIPT_ISSUER_ACTIVATED_AT=

# Sites-integrated public MCP gateway dispatch into the shared Turso-backed
# durable lease queue. The control-plane private key belongs only to the Sites
# gateway runtime. Configure this set only together with the same complete
# Turso authority used by the trusted Runner; never combine it with a
# Sites-D1-only participant write path.
RUNNER_QUEUE_MODE=
RUNNER_CONTROL_PLANE_KEY_ID=
RUNNER_CONTROL_PLANE_PRIVATE_KEY_JWK=
RUNNER_DEFAULT_LIMITS_JSON=

# Trusted Runner process only. Keep execution disabled until migration 0032,
# issuer/result keys, the pinned image, and hosted recovery tests are complete.
RUNNER_EXECUTION_ENABLED=false
PROOFWEAVE_RUNNER_PROVIDER=e2b
RUNNER_CONSUMER_ID=runner:closed-alpha-01
RUNNER_CONTROL_PLANE_ISSUER_KEYS_JSON=[]
RUNNER_APPROVED_IMAGES_JSON=[]
RUNNER_RESULT_KEY_ID=
RUNNER_RESULT_PRIVATE_KEY_JWK=
RUNNER_LEASE_SECONDS=300
RUNNER_LEASE_HEARTBEAT_SECONDS=60
RUNNER_RETRY_DELAY_SECONDS=30
RUNNER_MAX_DELIVERY_ATTEMPTS=5
RUNNER_POLL_MILLISECONDS=1000

# E2B Sandbox provider. The API key belongs only to the trusted Runner process
# (or protected GitHub Actions environment), never to the Lean Sandbox. Build a
# template from the exact reviewed Runner image, then configure its immutable
# template id. Runtime creation disables all egress and public inbound traffic.
E2B_API_KEY=
PROOFWEAVE_E2B_TEMPLATE_NAME=proofweave-lean-runner:v1
PROOFWEAVE_E2B_TEMPLATE_ID=
PROOFWEAVE_E2B_TEMPLATE_BUILD_ID=
PROOFWEAVE_E2B_RUNNER_IMAGE=
PROOFWEAVE_E2B_REGISTRY_USERNAME=
PROOFWEAVE_E2B_REGISTRY_PASSWORD=
PROOFWEAVE_E2B_RESOURCE_POLICY_REVIEWED=false
PROOFWEAVE_E2B_CPU=2
PROOFWEAVE_E2B_MEMORY_MB=2048
PROOFWEAVE_E2B_TIMEOUT_MS=120000
PROOFWEAVE_E2B_STARTUP_TIMEOUT_MS=60000

# Modal SDK credentials belong only to the trusted runner process. The Lean
# Sandbox never receives them. Leave the policy gate false until the pinned
# image and provider resource limits have been reviewed.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
PROOFWEAVE_MODAL_APP=
PROOFWEAVE_MODAL_RUNNER_IMAGE=
PROOFWEAVE_MODAL_RESOURCE_POLICY_REVIEWED=false
PROOFWEAVE_MODAL_CPU=0.5
PROOFWEAVE_MODAL_CPU_LIMIT=1
PROOFWEAVE_MODAL_MEMORY_MIB=512
PROOFWEAVE_MODAL_MEMORY_LIMIT_MIB=1024
PROOFWEAVE_MODAL_TIMEOUT_MS=120000
PROOFWEAVE_MODAL_IDLE_TIMEOUT_MS=30000

# Leave dynamic OAuth client registration disabled in the private alpha.
# To deliberately enable it on the Sites identity runtime, set a finite,
# operator-reviewed JSON array of exact OAuth client metadata. This is not a
# secret and must never contain wildcard redirect URIs.
# OAUTH_CLIENT_REGISTRATION_ALLOWLIST_JSON=[{"client_name":"Approved client","redirect_uris":["https://client.example/callback"]}]
