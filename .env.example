# Public URL used when generating links outside a request context.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Optional Google OpenID Connect sign-in. Configure these as hosted environment
# variables/secrets; never commit real values. The authorized redirect URI must
# exactly match the public HTTPS callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-proofweave-host.example/auth/google/callback

# Reserved for the separately deployed Lean runner. The web Worker must never
# execute user Lean code directly. Leave empty until the runner contract exists.
PROOFWEAVE_RUNNER_URL=
PROOFWEAVE_RUNNER_AUDIENCE=proofweave-lean-runner

# External control-plane process only. The current Sites frontend keeps its D1
# binding. For a new free Turso database, install/login to the official Turso
# CLI and run `npm run turso:bootstrap`; it writes these values only to the
# gitignored `.env.local` file with mode 0600. Never commit the real token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# MCP control-plane Receipt issuer. The three public values may be normal
# hosted environment variables; the private JWK must be stored as a hosted
# secret and must never be committed. Omitting all four keeps signed reviews
# durable but reports receipt closure as issuer_unavailable.
RECEIPT_ISSUER_KEY_ID=
RECEIPT_ISSUER_PUBLIC_KEY=
RECEIPT_ISSUER_PRIVATE_KEY_JWK=
RECEIPT_ISSUER_ACTIVATED_AT=

# Trusted Runner process only. Keep execution disabled until migration 0032,
# issuer/result keys, the pinned image, and hosted recovery tests are complete.
RUNNER_EXECUTION_ENABLED=false
RUNNER_CONSUMER_ID=runner:closed-alpha-01
RUNNER_CONTROL_PLANE_ISSUER_KEYS_JSON=[]
RUNNER_APPROVED_IMAGES_JSON=[]
RUNNER_RESULT_KEY_ID=
RUNNER_RESULT_PRIVATE_KEY_JWK=
RUNNER_LEASE_SECONDS=300
RUNNER_LEASE_HEARTBEAT_SECONDS=60
RUNNER_RETRY_DELAY_SECONDS=30
RUNNER_MAX_DELIVERY_ATTEMPTS=5
RUNNER_POLL_MILLISECONDS=1000

# Modal SDK credentials belong only to the trusted runner process. The Lean
# Sandbox never receives them. Leave the policy gate false until the pinned
# image and provider resource limits have been reviewed.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
PROOFWEAVE_MODAL_APP=
PROOFWEAVE_MODAL_RUNNER_IMAGE=
PROOFWEAVE_MODAL_RESOURCE_POLICY_REVIEWED=false
PROOFWEAVE_MODAL_CPU=0.5
PROOFWEAVE_MODAL_CPU_LIMIT=1
PROOFWEAVE_MODAL_MEMORY_MIB=512
PROOFWEAVE_MODAL_MEMORY_LIMIT_MIB=1024
PROOFWEAVE_MODAL_TIMEOUT_MS=120000
PROOFWEAVE_MODAL_IDLE_TIMEOUT_MS=30000

# Leave dynamic OAuth client registration disabled in the private alpha.
# To deliberately enable it on the Sites identity runtime, set a finite,
# operator-reviewed JSON array of exact OAuth client metadata. This is not a
# secret and must never contain wildcard redirect URIs.
# OAUTH_CLIENT_REGISTRATION_ALLOWLIST_JSON=[{"client_name":"Approved client","redirect_uris":["https://client.example/callback"]}]
