# syntax=docker/dockerfile:1.7
#
# Revision-pinned Mathlib base for the private Proofweave Runner. Network is
# available only while this independently inspectable base is assembled. The
# final credential-free Runner image is still built with --network=none.
ARG NODE_BASE_IMAGE
FROM ${NODE_BASE_IMAGE}

ARG NODE_BASE_IMAGE
ARG EXPECTED_LEAN_TOOLCHAIN
ARG EXPECTED_MATHLIB_REVISION
ARG LEAN_RELEASE_URL
ARG LEAN_RELEASE_SHA256
ARG LEAN_ARCHIVE_ROOT

RUN node --input-type=module -e '\
  const [base, toolchain, mathlib, url, digest, root] = process.argv.slice(1); \
  if (!/^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$/.test(base)) throw new Error("NODE_BASE_IMAGE must be pinned by sha256 digest."); \
  const match = /^leanprover\/lean4:v(\d+\.\d+\.\d+)$/.exec(toolchain); \
  if (!match) throw new Error("EXPECTED_LEAN_TOOLCHAIN must be an exact Lean release."); \
  if (!/^[a-f0-9]{40}$/.test(mathlib)) throw new Error("EXPECTED_MATHLIB_REVISION must be an exact Git commit."); \
  const version = match[1]; \
  if (url !== `https://github.com/leanprover/lean4/releases/download/v${version}/lean-${version}-linux.tar.zst`) throw new Error("LEAN_RELEASE_URL must match the exact official Lean release."); \
  if (!/^[a-f0-9]{64}$/.test(digest)) throw new Error("LEAN_RELEASE_SHA256 must be an exact sha256 digest."); \
  if (root !== `lean-${version}-linux`) throw new Error("LEAN_ARCHIVE_ROOT must match the exact Lean release archive."); \
' "$NODE_BASE_IMAGE" "$EXPECTED_LEAN_TOOLCHAIN" "$EXPECTED_MATHLIB_REVISION" "$LEAN_RELEASE_URL" "$LEAN_RELEASE_SHA256" "$LEAN_ARCHIVE_ROOT"

RUN command -v curl \
 && command -v sha256sum \
 && command -v git \
 && command -v tar \
 && command -v patch

RUN curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
      "$LEAN_RELEASE_URL" --output /tmp/lean-release.tar.zst \
 && echo "$LEAN_RELEASE_SHA256  /tmp/lean-release.tar.zst" | sha256sum --check --strict \
 && node --input-type=module -e '\
      import { createReadStream, createWriteStream } from "node:fs"; \
      import { pipeline } from "node:stream/promises"; \
      import { createZstdDecompress } from "node:zlib"; \
      await pipeline(createReadStream("/tmp/lean-release.tar.zst"), createZstdDecompress(), createWriteStream("/tmp/lean-release.tar")); \
    ' \
 && install -d -m 0755 /opt/lean-archive /opt/lean \
 && tar -xf /tmp/lean-release.tar -C /opt/lean-archive \
 && cp -a "/opt/lean-archive/$LEAN_ARCHIVE_ROOT/." /opt/lean/ \
 && rm -rf /opt/lean-archive /tmp/lean-release.tar /tmp/lean-release.tar.zst

ENV PATH="/opt/lean/bin:${PATH}"
ENV PROOFWEAVE_IMAGE_METADATA=/opt/proofweave/lean-environment.json
ENV PROOFWEAVE_LAKE_PACKAGES_ROOT=/opt/proofweave/lake-packages

# Create the same unprivileged identity used by the final Runner before Lake
# materializes any Git dependency. Git refuses repositories owned by another
# uid; Lake otherwise interprets that protected-directory refusal as a changed
# remote URL and tries to replace the immutable, read-only package closure.
RUN addgroup --system proofweave \
 && adduser --system --ingroup proofweave --home /home/proofweave --shell /usr/sbin/nologin proofweave

# E2B may materialize an imported image with remapped numeric ownership even
# when commands run as the named proofweave user. The dependency source/olean
# closure is public data, so make every directory traversable and every file
# readable before removing write bits. Lake is the sole exception: when this
# closure is mounted into a different project it rewrites the already-existing
# .lake/config package records using a temporary file plus atomic rename. Those
# small generated records and their config subtree must therefore remain
# writable in the fresh, one-Run Sandbox; package source and build output remain
# read-only.
RUN git clone --filter=blob:none --no-checkout https://github.com/leanprover-community/mathlib4.git /tmp/mathlib \
 && git -C /tmp/mathlib fetch --depth=1 origin "$EXPECTED_MATHLIB_REVISION" \
 && git -C /tmp/mathlib checkout --detach "$EXPECTED_MATHLIB_REVISION" \
 && test "$(git -C /tmp/mathlib rev-parse HEAD)" = "$EXPECTED_MATHLIB_REVISION" \
 && test "$(cat /tmp/mathlib/lean-toolchain)" = "$EXPECTED_LEAN_TOOLCHAIN" \
 && cd /tmp/mathlib \
 && lake exe cache get \
 && printf 'import Mathlib\n#check Nat\n' > ProofweaveImageSmoke.lean \
 && lake env lean ProofweaveImageSmoke.lean \
 && rm ProofweaveImageSmoke.lean \
 && install -d -m 0755 /opt/proofweave/lake-packages \
 && cp -a /tmp/mathlib/.lake/packages/. /opt/proofweave/lake-packages/ \
 && rm -rf /tmp/mathlib/.lake/packages \
 && mv /tmp/mathlib /opt/proofweave/lake-packages/mathlib \
 && ln -s ../.. /opt/proofweave/lake-packages/mathlib/.lake/packages \
 && chown -R proofweave:proofweave /opt/proofweave/lake-packages \
 && chmod -R a+rX,a-w /opt/proofweave/lake-packages \
 && test -n "$(find /opt/proofweave/lake-packages -path '*/.lake/config/*' -type f -print -quit)" \
 && find /opt/proofweave/lake-packages \( -path '*/.lake/config' -o -path '*/.lake/config/*' \) -type d -exec chmod a+rwx {} + \
 && find /opt/proofweave/lake-packages -path '*/.lake/config/*' -type f -exec chmod a+rw {} + \
 && su -s /bin/sh nobody -c 'test -z "$(find /opt/proofweave/lake-packages \( -type f ! -readable -o -type d ! -readable -o -type d ! -executable \) -print -quit)"'

# Exercise Lake from an external project, exactly like a staged Bundle. Running
# only from the Mathlib checkout does not make Lake rewrite its package config
# and therefore missed the production permission failure this gate prevents.
RUN install -d -o proofweave -g proofweave -m 0700 /tmp/proofweave-external-smoke/.lake \
 && ln -s /opt/proofweave/lake-packages /tmp/proofweave-external-smoke/.lake/packages \
 && printf 'import Lake\nopen Lake DSL\npackage proofweaveExternalSmoke\nrequire mathlib from git "https://github.com/leanprover-community/mathlib4.git" @ "%s"\n' "$EXPECTED_MATHLIB_REVISION" > /tmp/proofweave-external-smoke/lakefile.lean \
 && printf '%s\n' "$EXPECTED_LEAN_TOOLCHAIN" > /tmp/proofweave-external-smoke/lean-toolchain \
 && printf 'import Mathlib\n#check Nat\n' > /tmp/proofweave-external-smoke/ProofweaveImageSmoke.lean \
 && node --input-type=module -e '\
      import { readFile, writeFile } from "node:fs/promises"; \
      const [source, destination, revision] = process.argv.slice(1); \
      const manifest = JSON.parse(await readFile(source, "utf8")); \
      const mathlib = { url: "https://github.com/leanprover-community/mathlib4.git", type: "git", subDir: null, scope: "", rev: revision, name: "mathlib", manifestFile: "lake-manifest.json", inputRev: revision, inherited: false, configFile: "lakefile.lean" }; \
      await writeFile(destination, `${JSON.stringify({ ...manifest, name: "proofweaveExternalSmoke", packages: [mathlib, ...manifest.packages] }, null, 2)}\n`); \
    ' /opt/proofweave/lake-packages/mathlib/lake-manifest.json /tmp/proofweave-external-smoke/lake-manifest.json "$EXPECTED_MATHLIB_REVISION" \
 && chown -R proofweave:proofweave /tmp/proofweave-external-smoke \
 && su -s /bin/sh proofweave -c 'cd /tmp/proofweave-external-smoke && lake env lean ProofweaveImageSmoke.lean' \
 && rm -rf /tmp/proofweave-external-smoke

RUN install -d -m 0755 /opt/proofweave \
 && node --input-type=module -e '\
  import { writeFile } from "node:fs/promises"; \
  const [path, leanToolchain, mathlibRevision, leanReleaseSha256] = process.argv.slice(1); \
  await writeFile(path, `${JSON.stringify({ \
    protocolVersion: "pw-lean-image-v1", \
    profile: "mathlib-pinned", \
    leanToolchain, \
    mathlibRevision, \
    leanReleaseSha256, \
  }, null, 2)}\n`, { encoding: "utf8", mode: 0o644 }); \
' "$PROOFWEAVE_IMAGE_METADATA" "$EXPECTED_LEAN_TOOLCHAIN" "$EXPECTED_MATHLIB_REVISION" "$LEAN_RELEASE_SHA256"

LABEL org.opencontainers.image.title="Proofweave pinned Mathlib base" \
      io.proofweave.lean-toolchain="${EXPECTED_LEAN_TOOLCHAIN}" \
      io.proofweave.mathlib-revision="${EXPECTED_MATHLIB_REVISION}" \
      io.proofweave.runner-profile="mathlib-pinned"
