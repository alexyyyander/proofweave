{
  "schemaVersion": "pw-github-external-config-policy-v1",
  "repository": {
    "fullName": "alexyyyander/proofweave",
    "id": 1298911069
  },
  "environment": {
    "name": "proofweave-runner-alpha",
    "canAdminsBypass": false,
    "preventSelfReview": false,
    "requiredReviewers": [
      {
        "type": "User",
        "login": "alexyyyander",
        "id": 87079793
      }
    ],
    "deploymentBranches": {
      "protectedBranches": false,
      "customBranchPolicies": true,
      "patterns": [
        "main",
        "release/*"
      ]
    },
    "renderBoundVariables": [
      "PROOFWEAVE_E2B_RUNNER_IMAGE",
      "PROOFWEAVE_E2B_TEMPLATE_BUILD_ID",
      "PROOFWEAVE_E2B_TEMPLATE_ID",
      "RUNNER_APPROVED_IMAGES_JSON"
    ],
    "allowedSecretNames": [
      "E2B_API_KEY",
      "RUNNER_RESULT_PRIVATE_KEY_JWK",
      "TURSO_AUTH_TOKEN",
      "TURSO_DATABASE_URL"
    ],
    "forbiddenSecretNameMarkers": [
      "DEMO",
      "FIXTURE",
      "MOCK",
      "SMOKE"
    ]
  },
  "recoveryWorkflows": [
    ".github/workflows/build-week-live-receipt.yml",
    ".github/workflows/e2b-lean-runner.yml"
  ],
  "repositoryActions": {
    "enabled": true,
    "shaPinningRequired": true
  }
}
